---
import Base from "../../layouts/Base.astro";
import { articles, articlesByPillar } from "../../lib/articles";
import { pillars, site } from "../../data/site";
import { breadcrumbLd, physicianRef } from "../../lib/schema";

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const { data, Content } = a;
const pillar = pillars.find((p) => p.slug === data.pillar);
// 內部連結：同主題的其他文章（叢集互連）
const related = articlesByPillar(data.pillar).filter((x) => x.slug !== a.slug).slice(0, 5);
const url = `${site.url}/articles/${a.slug}/`;

const ld: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    headline: data.title,
    description: data.description,
    url,
    inLanguage: "zh-TW",
    datePublished: data.published,
    dateModified: data.reviewed,
    lastReviewed: data.reviewed,
    author: physicianRef,
    reviewedBy: physicianRef,
    ...(pillar ? { about: { "@type": "MedicalCondition", name: pillar.title } } : {}),
  },
  breadcrumbLd([
    { name: "首頁", path: "/" },
    ...(pillar ? [{ name: pillar.title, path: `/topics/${pillar.slug}/` }] : []),
    { name: data.title, path: `/articles/${a.slug}/` },
  ]),
];
if (data.faq?.length) {
  ld.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---
<Base
  title={data.title}
  description={data.description}
  jsonLd={ld}
  noindex={data.draft}
  ogType="article"
  publishedTime={data.published}
  modifiedTime={data.reviewed}
>
  <article>
    <div class="crumbs">
      <a href="/">首頁</a>
      {pillar && <> › <a href={`/topics/${pillar.slug}/`}>{pillar.title}</a></>}
    </div>
    <h1>{data.title}</h1>
    <div class="meta">
      <span>撰文：<a href="/about/">{site.doctorNameZh}醫師</a></span>
      <span>最近審閱：<time datetime={data.reviewed}>{data.reviewed}</time></span>
    </div>

    <Content />

    {data.faq?.length ? (
      <section>
        <h2>常見問題</h2>
        {data.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    ) : null}

    {related.length ? (
      <aside class="box">
        <h2>延伸閱讀</h2>
        <ul>
          {related.map((r) => <li><a href={`/articles/${r.slug}/`}>{r.data.title}</a></li>)}
        </ul>
        {pillar && <p><a href={`/topics/${pillar.slug}/`}>看{pillar.title}所有文章 →</a></p>}
      </aside>
    ) : pillar ? (
      <aside class="box">
        <h2>延伸閱讀</h2>
        <p><a href={`/topics/${pillar.slug}/`}>看{pillar.title}所有文章 →</a></p>
      </aside>
    ) : null}

    {data.references?.length ? (
      <section>
        <h2>參考文獻</h2>
        <ol class="refs">
          {data.references.map((r) => (
            <li>{r.url ? <a href={r.url} rel="noopener">{r.text}</a> : r.text}</li>
          ))}
        </ol>
      </section>
    ) : null}

    <p class="muted">本文為一般衛教資訊，不能取代個別診療。症狀持續或有疑慮，請與您的醫師討論。</p>
  </article>
</Base>
