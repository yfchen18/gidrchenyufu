---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { site } from "../../data/site";
import { getNews, newsTitle } from "../../lib/news";
import { breadcrumbLd, physicianRef } from "../../lib/schema";

// draft: true 的週報不產生頁面
export async function getStaticPaths() {
  return (await getNews()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const url = `${site.url}/news/${entry.id}/`;

const ld: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    headline: data.title,
    description: data.description,
    url,
    inLanguage: "zh-TW",
    datePublished: data.published,
    dateModified: data.reviewed,
    lastReviewed: data.reviewed,
    author: physicianRef,
    reviewedBy: physicianRef,
    ...(data.keywords?.length ? { keywords: data.keywords.join(", ") } : {}),
    isPartOf: { "@type": "CollectionPage", name: newsTitle, url: `${site.url}/news/` },
  },
  breadcrumbLd([
    { name: "首頁", path: "/" },
    { name: newsTitle, path: "/news/" },
    { name: data.title, path: `/news/${entry.id}/` },
  ]),
];
if (data.faq?.length) {
  ld.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---
<Base
  title={data.title}
  description={data.description}
  jsonLd={ld}
  ogType="article"
  publishedTime={data.published}
  modifiedTime={data.reviewed}
>
  <article>
    <div class="crumbs">
      <a href="/">首頁</a> › <a href="/news/">{newsTitle}</a>
    </div>
    <h1>{data.title}</h1>
    <div class="meta">
      <span>撰文／審閱：<a href="/about/">{site.doctorNameZh}醫師</a></span>
      <span>發布：<time datetime={data.published}>{data.published}</time></span>
      <span>最近審閱：<time datetime={data.reviewed}>{data.reviewed}</time></span>
      {data.sources_period && <span>資料期間：{data.sources_period}</span>}
    </div>

    <Content />

    {data.faq?.length ? (
      <section>
        <h2>常見問題</h2>
        {data.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    ) : null}

    {data.references?.length ? (
      <section>
        <h2>參考文獻</h2>
        <ol class="refs">
          {data.references.map((r) => (
            <li>{r.url ? <a href={r.url} rel="noopener">{r.text}</a> : r.text}</li>
          ))}
        </ol>
      </section>
    ) : null}

    <aside class="box">
      <h2>更多週報</h2>
      <p><a href="/news/">看{newsTitle}所有期數 →</a></p>
    </aside>

    <p class="muted">本文為一般衛教資訊，不能取代個別診療。症狀持續或有疑慮，請與您的醫師討論。</p>
  </article>
</Base>
