---
import Base from "../../layouts/Base.astro";
import { getNews, newsTitle } from "../../lib/news";
import { breadcrumbLd } from "../../lib/schema";

const posts = await getNews();
const description = "胃腸肝膽專科醫師每週整理的腸胃、肝膽最新研究與指引重點，附原始文獻。";
---
<Base
  title={newsTitle}
  description={description}
  jsonLd={breadcrumbLd([{ name: "首頁", path: "/" }, { name: newsTitle, path: "/news/" }])}
>
  <h1>{newsTitle}</h1>
  <p class="lead">{description}</p>
  {posts.length ? (
    <ul class="list">
      {posts.map((p) => (
        <li>
          <a href={`/news/${p.id}/`}>{p.data.title}</a>
          <p><time datetime={p.data.published}>{p.data.published}</time>{p.data.sources_period && <> · 資料期間 {p.data.sources_period}</>}</p>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p class="notice">第一期週報即將推出，敬請期待。在那之前，歡迎先看看<a href="/articles/">衛教文章</a>。</p>
  )}
</Base>
