---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { physicianLd, breadcrumbLd } from "../lib/schema";
---
<Base
  title="關於醫師"
  description={`${site.doctorNameZh}醫師，內科與消化系專科醫師，專長胃腸內視鏡、幽門桿菌與脂肪肝。`}
  jsonLd={[
    { ...physicianLd, "@type": ["Person", "Physician"], hasCredential: site.credentials.map((c) => ({ "@type": "EducationalOccupationalCredential", name: c })) },
    breadcrumbLd([{ name: "首頁", path: "/" }, { name: "關於醫師", path: "/about/" }]),
  ]}
>
  <h1>關於{site.doctorNameZh}醫師</h1>
  <p class="lead">{site.philosophy}</p>

  <h2>專科資格</h2>
  <ul>{site.credentials.map((c) => <li>{c}</li>)}</ul>

  <h2>學經歷</h2>
  <ul>{site.education.map((e) => <li>{e}</li>)}</ul>

  <h2>專長</h2>
  <ul>
    <li>胃鏡、大腸鏡檢查與息肉切除</li>
    <li>胃食道逆流、消化性潰瘍、幽門桿菌治療</li>
    <li>脂肪肝與慢性肝病追蹤、腹部超音波</li>
  </ul>

  <h2>關於這個網站</h2>
  <p>
    這裡的文章由我本人撰寫或審閱，目的是用白話把常見的腸胃肝膽問題講清楚，
    幫助你在就醫前後做出更好的判斷。每篇文章都會標示參考文獻與最近審閱日期。
  </p>
</Base>
