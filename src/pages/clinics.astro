---
import Base from "../layouts/Base.astro";
import { site, clinics } from "../data/site";
import { breadcrumbLd, clinicLd } from "../lib/schema";

const ld = [
  ...clinics.map(clinicLd),
  breadcrumbLd([{ name: "首頁", path: "/" }, { name: "看診資訊", path: "/clinics/" }]),
];
const searchUrl = (addr: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addr)}`;
---
<Base
  title="看診資訊"
  description={`${site.doctorNameZh}醫師門診時間與看診地點：中壢長安內科、八德日日晴聯合診所。`}
  jsonLd={ld}
>
  <h1>看診資訊</h1>
  <p class="lead">門診時間如有異動，以診所公告為準，出發前建議先來電確認。</p>

  {clinics.map((c) => (
    <section id={c.id}>
      <h2>{c.name}</h2>
      <p>
        地址：<a href={c.mapUrl ?? searchUrl(c.address)} target="_blank" rel="noopener">{c.address}</a><br />
        電話：<a href={`tel:${c.phone.replace(/-/g, "")}`}>{c.phone}</a>
      </p>
      {c.social.length > 0 && (
        <p class="social">
          {c.social.map((s, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
            </>
          ))}
        </p>
      )}
      {c.booking && (
        <div class="booking">
          <a class="booking-btn" href={c.booking.url} target="_blank" rel="noopener">
            {c.booking.label}
          </a>
          <figure class="booking-qr">
            <img src={c.booking.qr} alt={`${c.name} ${c.booking.label} QR code`} width="120" height="120" loading="lazy" />
            <figcaption>或用手機掃描</figcaption>
          </figure>
        </div>
      )}
      {c.schedule.length ? (
        <table class="schedule">
          <thead><tr><th></th><th>上午</th><th>下午</th><th>晚上</th></tr></thead>
          <tbody>
            {c.schedule.map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                {row.slice(1).map((t) => <td>{t || "—"}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      ) : null}
      {c.note && <p class="muted">{c.note}</p>}
    </section>
  ))}

  <h2>主治項目</h2>
  <ul>{site.expertise.map((e) => <li>{e}</li>)}</ul>
</Base>

<style>
  /* 線上預約：手機以可點擊的按鈕為主，QR 只在較寬的螢幕顯示
     （手機無法掃自己螢幕上的 QR） */
  /* 診所的粉專／IG */
  .social {
    margin: -4px 0 14px;
    font-size: 0.95rem;
  }
  .booking {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin: 14px 0 20px;
  }
  .booking-btn {
    display: inline-block;
    background: #06c755;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: var(--radius);
    line-height: 1.3;
  }
  .booking-btn:hover,
  .booking-btn:focus-visible {
    background: #05ad4b;
    color: #fff;
  }
  .booking-qr {
    margin: 0;
    text-align: center;
  }
  .booking-qr img {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 6px;
  }
  .booking-qr figcaption {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 5px;
  }
  @media (max-width: 559px) {
    .booking-qr { display: none; }
  }
</style>
