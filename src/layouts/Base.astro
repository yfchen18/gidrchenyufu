---
import SocialLinks from "../components/SocialLinks.astro";
import { site, analytics } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  // 完整 <title>（不再自動加「｜陳昱甫醫師」），需要自訂標題格式時用
  fullTitle?: string;
  description?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  // 社群分享預覽圖（站內路徑或完整網址），預設 /og.jpg
  // 這張圖是醫師自己做的，直接換掉 public/og.jpg 即可；換圖請維持 1200×630
  image?: string;
  imageAlt?: string;
  // og:type：一般頁面 website，文章頁傳 article
  ogType?: "website" | "article";
  publishedTime?: string; // YYYY-MM-DD，僅 ogType="article" 時輸出
  modifiedTime?: string; // YYYY-MM-DD，僅 ogType="article" 時輸出
}
const {
  title,
  fullTitle: fullTitleProp,
  description = site.description,
  jsonLd,
  noindex = false,
  image = "/og.jpg",
  imageAlt = `${site.name}：${site.tagline}`,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;
const fullTitle = fullTitleProp ?? (title ? `${title}｜${site.doctorNameZh}醫師` : site.homeTitle);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const isDefaultImage = image === "/og.jpg";
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const nav = [
  { href: "/articles/", label: "衛教文章" },
  { href: "/news/", label: "新知週報" },
  { href: "/about/", label: "關於醫師" },
  { href: "/clinics/", label: "看診資訊" },
  { href: "/contact/", label: "聯絡" },
];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {analytics.googleSiteVerification && (
      <meta name="google-site-verification" content={analytics.googleSiteVerification} />
    )}
    {/* 標題用的襯線中文字型。只載 700 一個字重，Google Fonts 會依實際用到的字
        做 unicode-range 切片，不會整套 CJK 下載。內文維持系統字。 */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@700&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {/* 分析工具只在正式建置時載入，本機 npm run dev 不會送出資料 */}
    {import.meta.env.PROD && analytics.ga4MeasurementId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4MeasurementId}`}
        />
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analytics.ga4MeasurementId}');`}
        />
      </>
    )}
    {import.meta.env.PROD && analytics.cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${analytics.cloudflareToken}"}`}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand">
          <span class="brand-name">{site.doctorNameZh}醫師</span>
          <span class="brand-sub">胃腸肝膽專科 · Gastroenterology &amp; Hepatology</span>
        </a>
        <nav aria-label="主選單">
          {nav.map((n) => <a href={n.href} aria-current={Astro.url.pathname.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>本網站內容為一般衛生教育資訊，不能取代個別診療。身體不適請就醫，緊急狀況請撥 119。</p>
        <SocialLinks />
        <p><a href="/disclaimer/">免責聲明</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="muted">© {new Date().getFullYear()} {site.doctorNameEn}</p>
      </div>
    </footer>
  </body>
</html>
