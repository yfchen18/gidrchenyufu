{
  // Cloudflare Workers 靜態網站設定：部署 Astro 輸出的 dist 資料夾
  "name": "gidrchenyufu",
  "compatibility_date": "2026-10-01",
  // 綁定自訂網域：部署時 Cloudflare 會自動建立 DNS 與 SSL 憑證
  "routes": [{ "pattern": "gidrchenyufu.com", "custom_domain": true }],
  // 關掉 gidrchenyufu.<帳號>.workers.dev：否則正式站在那個網址也有一份一模一樣的內容，
  // 對搜尋引擎來說是重複站。正式網址只保留上面的自訂網域。
  "workers_dev": false,
  // preview_urls 沒寫時會跟著 workers_dev 一起被關掉，PR 預覽部署就會失效，所以明確打開。
  // 預覽網址由 astro.config.mjs 在非 main 分支的建置加上 X-Robots-Tag: noindex，不會被收錄。
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // PR 的預覽部署走 `wrangler preview`，而那個指令要求設定檔有 previews 區塊，
  // 沒有就直接失敗。空物件即可：assets、相容性設定等仍留在上層，不需要搬進來。
  // 正式部署（main 走 `wrangler deploy`）不受這個區塊影響。
  "previews": {}
}
